2# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Twilio Configuration (Required for call management)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Server Configuration
PORT=3000
BASE_URL=https://your-domain.com
NODE_ENV=development

# Audio Processing Configuration (optional - defaults to enabled)
AUDIO_PROCESSING_ENABLED=true
AUDIO_NOISE_SUPPRESSION=true
AUDIO_ECHO_CANCELLATION=true
AUDIO_AUTO_GAIN_CONTROL=true
